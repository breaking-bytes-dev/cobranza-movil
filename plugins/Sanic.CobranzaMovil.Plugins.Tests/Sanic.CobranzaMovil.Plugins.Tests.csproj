<Project Sdk="Microsoft.NET.Sdk">

  <!-- Las pruebas corren en net462 (mismo runtime que el sandbox de Dataverse). Por eso el workflow las
       ejecuta en un runner Windows. Ver plugins/Sanic.CobranzaMovil.Plugins/README.md. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Sanic.CobranzaMovil.Plugins.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <!-- Moq 4.18.4: ultima version previa a SponsorLink (4.20.0-4.20.1). Ver README, seccion Pruebas. -->
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanic.CobranzaMovil.Plugins\Sanic.CobranzaMovil.Plugins.csproj" />
  </ItemGroup>

</Project>
