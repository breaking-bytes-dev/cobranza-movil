<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ensamblado de plugins de Cobranza Movil.
    - net462: el sandbox de Dataverse carga ensamblados de .NET Framework.
    - Sin dependencias en tiempo de ejecucion fuera del SDK de Dataverse (el ensamblado se sube SOLO, sin ILMerge).
    - Firma de nombre seguro: Dataverse la exige. La clave NO esta en el repo (*.snk esta en .gitignore).
      Se pasa por linea de comandos: -p:AssemblyOriginatorKeyFile=<ruta al .snk>.
      Sin ese parametro el ensamblado compila SIN firmar (suficiente para las pruebas, NO registrable).
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Sanic.CobranzaMovil.Plugins</AssemblyName>
    <RootNamespace>Sanic.CobranzaMovil.Plugins</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AssemblyVersion>1.0.11.3</AssemblyVersion>
    <FileVersion>1.0.11.3</FileVersion>
    <Version>1.0.11.3</Version>
    <Company>Sanic</Company>
    <Product>Cobranza Movil</Product>
    <Description>Plugins de Cobranza Movil: PanGuard, PanEnTextoLibre, ClaveDesdeCuenta, CuentaDesdeInteraccion, IdentidadEnInteraccion, AprobacionEspecial, ActualizacionConInteraccion, VincularActualizacionPendiente, EmailDesdeUsuario, RepartoAsignacion, RepartoPorAgente, ColumnasAsignacion, CargaSobreAsignacion, Reclasificacion, EspecialDesdeCuenta, TramoCartera, TipoDesdeProducto, InteraccionDelCobrador, GrabacionInteraccion, ReciboRepetido y PurgaArchivoCarga; Custom APIs SolicitarEspecial, AltaCuenta, PartirCarga y CerrarFueraDeCartera.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AssemblyOriginatorKeyFile)' != ''">
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
